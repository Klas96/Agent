[Unit]
Description=PocketFlow Payment Monitor
After=network.target pocketflow.service

[Service]
Type=simple
User=pocketflow
Group=pocketflow
WorkingDirectory=/opt/pocketflow
Environment=PATH=/opt/pocketflow/venv/bin
Environment=PYTHONPATH=/opt/pocketflow/src
ExecStart=/opt/pocketflow/venv/bin/python /opt/pocketflow/payment_monitor.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pocketflow/data /opt/pocketflow/logs /opt/pocketflow/.electrum

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pocketflow-payment-monitor

[Install]
WantedBy=multi-user.target 